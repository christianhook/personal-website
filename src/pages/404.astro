---
import { SITE_TITLE } from "../consts";
import AppLayout from "../layouts/app/AppLayout.astro";
import PageLayout from "../layouts/PageLayout.astro";
---

<AppLayout title={`${SITE_TITLE} - Page Not Found`}>
    <PageLayout>
        <div class="flex flex-col items-center justify-center py-16 text-center">
            <h1 class="font-bold text-6xl mb-4 text-black dark:text-white">404</h1>
            <h2 class="font-semibold text-2xl mb-6 text-black dark:text-white">Page Not Found</h2>
            <p class="text-black dark:text-white mb-8">
                The page you're looking for doesn't exist or has been moved.
            </p>
            <a
                href="/"
                class="px-4 py-2 rounded-lg bg-zinc-200 dark:bg-zinc-800 text-black dark:text-white hover:bg-zinc-300 dark:hover:bg-zinc-700 transition-colors duration-300"
            >
                Return Home
            </a>
        </div>
    </PageLayout>
</AppLayout>
