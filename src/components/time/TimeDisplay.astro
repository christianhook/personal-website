---
const now = new Date();
const timeFormatter = new Intl.DateTimeFormat("en-DK", {
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
    timeZone: "Europe/Copenhagen",
});
const time = timeFormatter.format(now);
---

<div class="flex flex-row items-center mb-2 space-x-0 sm:space-x-2 w-full px-5 pb-2 sm:pb-0 sm:px-0 md:justify-end">
    <div>
        <p
            class="text-black dark:text-white text-center"
            title="Updates every minute while this page is open"
        >
            Time in Copenhagen is{" "}
            <time datetime={now.toISOString()} data-copenhagen-time>
                {time}
            </time>
        </p>
    </div>
</div>

<script is:inline>
    (() => {
        const loadClock = () =>
            import("/scripts/copenhagen-clock.js").catch(() => {
                // The clock still shows the server-rendered time if this fails.
            });

        if (document.readyState === "complete") {
            loadClock();
        } else {
            window.addEventListener("load", loadClock, { once: true });
        }
    })();
</script>
