---
import Spotify from "../../components/spotify/Spotify.astro";
import SpotifyFallback from "../../components/spotify/SpotifyFallback.astro";
import TimeDisplay from "../../components/time/TimeDisplay.astro";
---

<footer class="flex flex-col items-center w-full">
    <div class="flex flex-col w-full max-w-2xl px-4 md:px-8 mb-4">
        <hr class="w-full border-1 border-zinc-200 dark:border-zinc-800 mb-4" />
        <div class="flex flex-col md:flex-row md:justify-between items-center md:items-start w-full">
            <div class="w-full md:w-auto">
                <Spotify server:defer>
                    <SpotifyFallback slot="fallback" />
                </Spotify>
                <div class="px-5 sm:px-0">
                    <a
                        href="/music"
                        data-astro-prefetch
                        class="rounded-lg text-xs text-zinc-500 transition-colors hover:text-black dark:text-zinc-400 dark:hover:text-white"
                    >
                        My 10 most-played tracks lately
                    </a>
                </div>
            </div>
            <div class="w-full md:w-auto">
                <TimeDisplay />
            </div>
        </div>
    </div>
</footer>
