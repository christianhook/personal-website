        "prettier-plugin-svelte": "^4.1.1",
        "rollup-plugin-visualizer": "^7.1.1",
        "svelte": "^5.57.2",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
