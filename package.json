        "mode-watcher": "^1.1.0",
        "nanostores": "^1.5.5"
    },
    "devDependencies": {
        "@astrojs/mdx": "^8.1.1",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "@astrojs/svelte": "^9.1.1",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/luxon": "^3.7.6",
        "@typescript-eslint/parser": "^8.72.0",
        "astro": "^7.4.2",
